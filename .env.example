# ─── LLM providers ─────────────────────────────────────────────
# Active chat provider: claude | openai | gemini  (switching is a config change)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# Optional: OpenAI-compatible gateway (e.g. OpenRouter). Then set OPENAI_MODEL=openai/gpt-4o
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Per-provider model ids
CLAUDE_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4.1
# `gemini-flash-latest` = the current Flash; gemini-2.0-flash / 2.5-flash are RETIRED.
GEMINI_MODEL=gemini-flash-latest
# Embeddings (separate from chat provider)
# EMBED_LOCAL=true runs a Transformers.js model on-device — NO API key needed
# (downloads the model once, then fully offline). Set false to use the cloud provider.
EMBED_LOCAL=false
EMBED_LOCAL_MODEL=Xenova/bge-small-en-v1.5
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small

# ─── HighLevel: auth ───────────────────────────────────────────
# Option A (simplest): a Private Integration Token — a static bearer created in
# the sub-account (Settings → Private Integrations). Set this and OAuth is skipped.
HL_PRIVATE_TOKEN=
# Option B: OAuth (Marketplace app). Tokens are obtained + refreshed by the harness.
HL_CLIENT_ID=
HL_CLIENT_SECRET=
HL_REDIRECT_URI=http://localhost:3000/oauth/callback
HL_WEBHOOK_SECRET=
# Where the OAuth callback redirects the browser after a successful install (default '/').
# OAUTH_SUCCESS_REDIRECT=/
# Encrypts the OAuth token at rest in Postgres (AES-256-GCM). Generate: openssl rand -hex 32.
# Unset = token stored unencrypted (fine for local; set it in prod).
# TOKEN_ENCRYPTION_KEY=
# Required in both modes:
HL_LOCATION_ID=

# ─── HighLevel: objects the skills reference ───────────────────
HL_CALENDAR_ID=
# User the booked appointment is assigned to (HighLevel requires an assignee)
HL_CALENDAR_USER_ID=
HL_FIELD_BUDGET_ID=
HL_FIELD_PREFERRED_TIME_ID=
HL_HANDOVER_TAG=bot-handover
HL_HANDOVER_USER_ID=

# ─── Tracing (optional; absent = disabled, JSON/CLI fallback stays on) ──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Self-hosted or cloud Langfuse base URL (e.g. https://cloud.langfuse.com)
LANGFUSE_BASEURL=

# ─── Persistence (optional) ────────────────────────────────────
# Set to back webhook idempotency with Postgres (durable lease). Absent = in-memory.
DATABASE_URL=
# Opt-in pgvector KB (needs the `vector` extension). Off = baked file index.
PGVECTOR=false

# ─── Server / runtime ──────────────────────────────────────────
PORT=3000
# Use the mock CRM (no sandbox needed) or the real HighLevel client: mock | highlevel
CRM_MODE=mock
RAG_SCORE_THRESHOLD=0.35
# Minutes of inactivity after which a conversation's in-memory context resets.
HISTORY_IDLE_RESET_MIN=30
# Coalesce a rapid burst of messages in one conversation into a single turn (ms).
# Lower = snappier replies, less burst-coalescing. 0 = off.
MESSAGE_DEBOUNCE_MS=2500
# development | test | production   ·   log level: fatal|error|warn|info|debug|trace
# NODE_ENV=development
# LOG_LEVEL=info

# ─── Agent messages (optional; sensible defaults shown) ────────
# Sent while a conversation is handed over to a human (empty = stay silent).
# HANDOVER_HOLDING_MESSAGE=Thanks for your message! A team member will follow up with you shortly.
# Best-effort reply when a turn errors mid-way (empty = stay silent).
# AGENT_FALLBACK_MESSAGE=Sorry — I'm having trouble on my end right now. A team member will follow up with you shortly.
