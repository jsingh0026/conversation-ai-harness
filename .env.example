# ─── LLM providers ─────────────────────────────────────────────
# Active chat provider: claude | openai | gemini  (switching is a config change)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# Optional: OpenAI-compatible gateway (e.g. OpenRouter). Then set OPENAI_MODEL=openai/gpt-4o
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Per-provider model ids
CLAUDE_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4.1
GEMINI_MODEL=gemini-2.0-flash
# Embeddings (separate from chat provider)
# EMBED_LOCAL=true runs a Transformers.js model on-device — NO API key needed
# (downloads the model once, then fully offline). Set false to use the cloud provider.
EMBED_LOCAL=false
EMBED_LOCAL_MODEL=Xenova/bge-small-en-v1.5
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small

# ─── HighLevel: auth ───────────────────────────────────────────
# Option A (simplest): a Private Integration Token — a static bearer created in
# the sub-account (Settings → Private Integrations). Set this and OAuth is skipped.
HL_PRIVATE_TOKEN=
# Option B: OAuth (Marketplace app). Tokens are obtained + refreshed by the harness.
HL_CLIENT_ID=
HL_CLIENT_SECRET=
HL_REDIRECT_URI=http://localhost:3000/oauth/callback
HL_WEBHOOK_SECRET=
# Required in both modes:
HL_LOCATION_ID=

# ─── HighLevel: objects the skills reference ───────────────────
HL_CALENDAR_ID=
# User the booked appointment is assigned to (HighLevel requires an assignee)
HL_CALENDAR_USER_ID=
HL_FIELD_BUDGET_ID=
HL_FIELD_PREFERRED_TIME_ID=
HL_HANDOVER_TAG=bot-handover
HL_HANDOVER_USER_ID=

# ─── Tracing (optional; absent = disabled, JSON/CLI fallback stays on) ──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=http://localhost:3000

# ─── Server / runtime ──────────────────────────────────────────
PORT=3000
# Use the mock CRM (no sandbox needed) or the real HighLevel client: mock | highlevel
CRM_MODE=mock
RAG_SCORE_THRESHOLD=0.35
